# Copy to .env for local development. On Vercel, set these as
# Environment Variables of the project instead.

# Required -------------------------------------------------------------

# Connection string of the coursegen_app role (written by
# course_gen_studio_front/db/apply_schema.py). Prefer the Neon pooled host
# (contains "-pooler") for serverless deployments.
COURSEGEN_DATABASE_URL="postgresql://coursegen_app:<password>@<host>-pooler.<region>.aws.neon.tech/<database>?sslmode=require"

# Secret used to sign the access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
COURSEGEN_JWT_SECRET_KEY="<random-secret>"

# Optional (defaults shown) --------------------------------------------

ENVIRONMENT=development
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=12
KEEP_SIGNED_IN_TTL_DAYS=30
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_THROTTLE_WINDOW_MINUTES=15

# Front-end page that reads "#reset_token=<token>" from the URL.
PASSWORD_RESET_URL=http://localhost:5500/coursegen-login.html
PASSWORD_RESET_TTL_MINUTES=30

# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# "console" only logs e-mails (development). Use "smtp" in production.
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_USE_TLS=true
